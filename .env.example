# Copy this file to .env and fill in your own Claude API key.
# .env is already in .gitignore, so it will not be committed to GitHub.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# API key for the /api/ endpoints (pass it in the X-API-Key header when calling them). A default is already set in docker-compose.
API_KEY=dev-secret-key

# --- Retrieval backend ---------------------------------------------------
# "hybrid"  -> Elasticsearch BM25 + kNN fused with RRF (needs the ES service)
# "pgvector" -> pure vector search in Postgres; use this if you start the core
#               services only (app/db/redis/worker) without ES, Kafka and MinIO.
RETRIEVAL_BACKEND=hybrid
ES_URL=http://elasticsearch:9200

# --- Document ingestion (claim-check: MinIO holds the bytes, Kafka the key) ---
KAFKA_BOOTSTRAP=kafka:9092
S3_ENDPOINT=http://minio:9000
S3_BUCKET=careplan-docs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
